{
  "Console Log": {
    "prefix": "log",
    "body": ["console.log(${1:value});$0"],
    "description": "console.log"
  },
  "Function": {
    "prefix": "fn",
    "body": ["function ${1:name}(${2:args}) {", "  ${0}", "}"],
    "description": "Function declaration"
  },
  "Arrow Function": {
    "prefix": "af",
    "body": ["const ${1:name} = (${2:args}) => {", "  ${0}", "};"],
    "description": "Arrow function"
  },
  "Interface": {
    "prefix": "int",
    "body": ["interface ${1:Name} {", "  ${2:key}: ${3:type};", "}$0"],
    "description": "Interface declaration"
  },
  "Type Alias": {
    "prefix": "type",
    "body": ["type ${1:Name} = {", "  ${2:key}: ${3:type};", "};$0"],
    "description": "Type alias"
  }
}
