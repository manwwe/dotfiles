{
  "Main Function": {
    "prefix": "main",
    "body": ["fn main() {", "    $0", "}"],
    "description": "Rust main function"
  },
  "Print Line": {
    "prefix": "pl",
    "body": ["println!(\"${1:{} }\", ${2:value});$0"],
    "description": "println! macro"
  },
  "Test Function": {
    "prefix": "test",
    "body": ["#[test]", "fn ${1:name}() {", "    ${0:assert!(true);}", "}"],
    "description": "Rust test function"
  },
  "Result Function": {
    "prefix": "fnr",
    "body": ["fn ${1:name}(${2:args}) -> Result<${3:()}, ${4:Box<dyn std::error::Error>}> {", "    ${0:Ok(())}", "}"],
    "description": "Function returning Result"
  }
}
